# Copy this file to .env.local and fill in the values.
# Never commit .env.local (it is git-ignored).

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_, never import in a "use client" file, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Base URL used for auth email redirects.
# e.g. http://localhost:3000 (dev) / https://prosflow.io (production)
NEXT_PUBLIC_SITE_URL=

# --- Google PageSpeed Insights (server-only) ---
PAGESPEED_API_KEY=

# --- Gemini (server-only, optional; used by GEO audit module) ---
GEMINI_API_KEY=
